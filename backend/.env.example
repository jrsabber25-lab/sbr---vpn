# SBR VPN Backend Configuration
# Generate a strong secret in production: openssl rand -hex 32
SBR_JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
SBR_JWT_EXPIRE_MINUTES=1440
SBR_DATABASE_URL=sqlite+aiosqlite:///./sbr_vpn.db
# Production PostgreSQL example:
# SBR_DATABASE_URL=postgresql+asyncpg://sbrvpn:STRONG_PASSWORD@db:5432/sbrvpn

# Shared HMAC secret between central API and WireGuard VPS node agents
SBR_NODE_AGENT_SECRET=CHANGE_ME_NODE_AGENT_SHARED_SECRET

# Initial bootstrap administrator account (change password immediately after first login)
SBR_BOOTSTRAP_ADMIN_EMAIL=admin@sbrvpn.example.com
SBR_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Allowed CORS origins for Admin Dashboard (comma-separated)
SBR_CORS_ORIGINS=https://admin.sbrvpn.example.com,http://localhost:8080
